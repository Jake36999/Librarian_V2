{
	"nodes":[
		{"id":"librarian-title","type":"text","x":20,"y":-200,"width":2180,"height":220,"text":"# Current approved batch: source and folder-metadata dispatch\n**Symptom:** A source-only child hides folder-metadata work present in the same approved batch.\n**Root cause:** The parent must expose the actual mixed dispatcher and metadata-only outcomes.\nLanes are actors; red arrows are extensions (numbered); red ends are ways the use case ends without success; orange cards call another use case. Generated from `batch-enrichment-current.spec.yaml`."},
		{"id":"librarian-s","type":"text","x":40,"y":140,"width":360,"height":70,"text":"● start","color":"4"},
		{
			"id":"librarian-contract",
			"type":"text",
			"x":40,
			"y":340,
			"width":360,
			"height":150,
			"text":"One existing process_approved worker. Child references describe its stage contracts; they do not start separate batches or create new run stores.",
			"librarian":{"actor_lane":"Tier 0 agent"}
		},
		{
			"id":"librarian-bind",
			"type":"text",
			"x":1240,
			"y":540,
			"width":360,
			"height":150,
			"text":"**1.** uses the already admitted mixed source/folder selection, batch settings, grants and completion keys",
			"librarian":{"actor_lane":"Core"}
		},
		{
			"id":"librarian-dwork",
			"type":"text",
			"x":1240,
			"y":740,
			"width":360,
			"height":150,
			"text":"◇ frozen items available?",
			"color":"5",
			"librarian":{"actor_lane":"Core"}
		},
		{
			"id":"librarian-nextitem",
			"type":"text",
			"x":1240,
			"y":1140,
			"width":360,
			"height":150,
			"text":"**2.** selects the next frozen item; completed and failed sibling records remain accounted for",
			"librarian":{"actor_lane":"Core"}
		},
		{"id":"librarian-enowork","type":"text","x":1840,"y":940,"width":360,"height":150,"text":"◉ no admitted work; parent still reconciles any outstanding decisions\n*outcome: reused*","color":"6"},
		{
			"id":"librarian-dkind",
			"type":"text",
			"x":1240,
			"y":1340,
			"width":360,
			"height":150,
			"text":"◇ recorded staged-item kind?",
			"color":"5",
			"librarian":{"actor_lane":"Core"}
		},
		{
			"id":"librarian-source",
			"type":"text",
			"x":1240,
			"y":4140,
			"width":360,
			"height":150,
			"text":"**3.** ⇉ **source-enrichment-current**: uses the current source-stage contract for this item, including its existing controls and in-item publication",
			"color":"2",
			"librarian":{"actor_lane":"Core"}
		},
		{
			"id":"librarian-foldercontrols",
			"type":"text",
			"x":1240,
			"y":1540,
			"width":360,
			"height":150,
			"text":"applies the same before-item ceiling, between-stage cancellation and active-writer controls to the folder card",
			"librarian":{"actor_lane":"Core"}
		},
		{
			"id":"librarian-account",
			"type":"text",
			"x":1240,
			"y":4740,
			"width":360,
			"height":150,
			"text":"**4.** retains the existing per-item stage/status reduction and updates the original mixed-batch accounting",
			"librarian":{"actor_lane":"Core"}
		},
		{
			"id":"librarian-stopped",
			"type":"text",
			"x":1240,
			"y":4340,
			"width":360,
			"height":150,
			"text":"retains completed receipts and remaining work with the actual cancellation, ceiling or interruption reason",
			"librarian":{"actor_lane":"Core"}
		},
		{"id":"librarian-eescalated","type":"text","x":1840,"y":4340,"width":360,"height":150,"text":"◉ a run-wide state, writer or authority failure prevents a trustworthy handback\n*outcome: escalated*","color":"1"},
		{
			"id":"librarian-dfoldercontrols",
			"type":"text",
			"x":1240,
			"y":1740,
			"width":360,
			"height":150,
			"text":"◇ folder item controls permit continuation?",
			"color":"5",
			"librarian":{"actor_lane":"Core"}
		},
		{
			"id":"librarian-dmore",
			"type":"text",
			"x":1240,
			"y":4940,
			"width":360,
			"height":150,
			"text":"◇ another frozen item?",
			"color":"5",
			"librarian":{"actor_lane":"Core"}
		},
		{"id":"librarian-epaused","type":"text","x":1840,"y":4540,"width":360,"height":150,"text":"◉ worker stopped with completed work retained and explicit continuation required\n*outcome: paused*","color":"1"},
		{
			"id":"librarian-foldervalidate",
			"type":"text",
			"x":1240,
			"y":1940,
			"width":360,
			"height":150,
			"text":"folder_validate: checks current inventory evidence and review fingerprints",
			"librarian":{"actor_lane":"Core"}
		},
		{
			"id":"librarian-summary",
			"type":"text",
			"x":1240,
			"y":5140,
			"width":360,
			"height":150,
			"text":"**5.** returns actual source/folder item outcomes and pending independent decisions; batch finished is not Source or lens acceptance",
			"librarian":{"actor_lane":"Core"}
		},
		{
			"id":"librarian-dfoldervalidate",
			"type":"text",
			"x":1240,
			"y":2140,
			"width":360,
			"height":150,
			"text":"◇ folder_validate result?",
			"color":"5",
			"librarian":{"actor_lane":"Core"}
		},
		{
			"id":"librarian-dresult",
			"type":"text",
			"x":1240,
			"y":5340,
			"width":360,
			"height":150,
			"text":"◇ recorded mixed-batch result?",
			"color":"5",
			"librarian":{"actor_lane":"Core"}
		},
		{
			"id":"librarian-dfolderroute",
			"type":"text",
			"x":1240,
			"y":2340,
			"width":360,
			"height":150,
			"text":"◇ production drafting enabled, or scripted endpoint?",
			"color":"5",
			"librarian":{"actor_lane":"Core"}
		},
		{
			"id":"librarian-folderfailed",
			"type":"text",
			"x":1240,
			"y":3540,
			"width":360,
			"height":150,
			"text":"records the failed folder stage and skips that card's remaining stages; completed siblings stay intact",
			"librarian":{"actor_lane":"Core"}
		},
		{"id":"librarian-e1","type":"text","x":1840,"y":5740,"width":360,"height":150,"text":"◉ recorded item stages complete or inapplicable; later Source/folder/lens decisions remain separate\n*outcome: success*","color":"6"},
		{"id":"librarian-epartial","type":"text","x":1840,"y":5540,"width":360,"height":150,"text":"◉ batch accounted for with recorded partial/queued/failed items; no content coverage is invented\n*outcome: partial*","color":"1"},
		{
			"id":"librarian-folderdescribe",
			"type":"text",
			"x":640,
			"y":2540,
			"width":360,
			"height":150,
			"text":"folder_describe: attempts description and sensitivity from inventory metadata; unavailable endpoint can fail without a model call; documents stay unread",
			"librarian":{"actor_lane":"Model worker (legacy transport)"}
		},
		{
			"id":"librarian-folderqueued",
			"type":"text",
			"x":1240,
			"y":2540,
			"width":360,
			"height":150,
			"text":"records folder_describe queued when production drafting is disabled; later applicable stages retain that status",
			"librarian":{"actor_lane":"Core"}
		},
		{
			"id":"librarian-foldercoverage",
			"type":"text",
			"x":1240,
			"y":3740,
			"width":360,
			"height":150,
			"text":"records folder coverage as metadata only, source content not examined; never credits its documents as read",
			"librarian":{"actor_lane":"Core"}
		},
		{
			"id":"librarian-foldercheck",
			"type":"text",
			"x":1240,
			"y":2740,
			"width":360,
			"height":150,
			"text":"checks returned structure/provenance and persists the draft under current item preconditions",
			"librarian":{"actor_lane":"Core"}
		},
		{
			"id":"librarian-folderdata",
			"type":"text",
			"x":1240,
			"y":3140,
			"width":360,
			"height":150,
			"text":"folder_data: saves the inventory Data record through the existing guarded writer",
			"librarian":{"actor_lane":"Core"}
		},
		{
			"id":"librarian-observed",
			"type":"text",
			"x":640,
			"y":3940,
			"width":360,
			"height":150,
			"text":"Audited 12 folder-item attempts in two batches: validation completed; description failed; no folder_data success observed in that sample.",
			"librarian":{"actor_lane":"Model worker (legacy transport)"}
		},
		{
			"id":"librarian-dfolderdescribe",
			"type":"text",
			"x":1240,
			"y":2940,
			"width":360,
			"height":150,
			"text":"◇ folder_describe result?",
			"color":"5",
			"librarian":{"actor_lane":"Core"}
		},
		{
			"id":"librarian-dfolderdata",
			"type":"text",
			"x":1240,
			"y":3340,
			"width":360,
			"height":150,
			"text":"◇ folder_data result?",
			"color":"5",
			"librarian":{"actor_lane":"Core"}
		},
		{"id":"librarian-lane-Tier-0-agent","type":"group","x":20,"y":60,"width":400,"height":5930,"label":"Tier 0 agent"},
		{"id":"librarian-lane-Model-worker-legacy-transport-","type":"group","x":620,"y":60,"width":400,"height":5930,"label":"Model worker (legacy transport)"},
