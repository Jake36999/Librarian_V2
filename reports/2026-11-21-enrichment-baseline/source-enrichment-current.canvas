{
	"nodes":[
		{"id":"librarian-title","type":"text","x":20,"y":-200,"width":3380,"height":220,"text":"# Current source enrichment: scripted stages and legacy model tasks\n**Symptom:** An ingestion summary can hide processing-start, per-item publication, partial outputs and later acceptance.\n**Root cause:** The parent needs the actual nine-stage child contract and per-item outcomes, separate from proposed coordination.\nLanes are actors; red arrows are extensions (numbered); red ends are ways the use case ends without success; orange cards call another use case. Generated from `source-enrichment-current.spec.yaml`."},
		{"id":"librarian-s","type":"text","x":40,"y":140,"width":360,"height":70,"text":"● start","color":"4"},
		{
			"id":"librarian-boundary",
			"type":"text",
			"x":40,
			"y":340,
			"width":360,
			"height":150,
			"text":"Source-only detail of the current mixed-batch dispatcher. Folder metadata uses its separate three-stage chain there. Approval/start and Source/lens decisions stay with the parent.",
			"librarian":{"actor_lane":"Tier 0 agent"}
		},
		{
			"id":"librarian-bind",
			"type":"text",
			"x":1240,
			"y":540,
			"width":360,
			"height":150,
			"text":"**1.** binds the source subset to the admitted batch, frozen selection, settings, grants and exact completion keys",
			"librarian":{"actor_lane":"Core"}
		},
		{
			"id":"librarian-dwork",
			"type":"text",
			"x":1240,
			"y":740,
			"width":360,
			"height":150,
			"text":"◇ source work in the admitted subset?",
			"color":"5",
			"librarian":{"actor_lane":"Core"}
		},
		{
			"id":"librarian-controls",
			"type":"text",
			"x":1240,
			"y":1140,
			"width":360,
			"height":150,
			"text":"**2.** checks the configured spend ceiling before each item and cancellation/active-writer state between stages; reuses only matching complete receipts",
			"librarian":{"actor_lane":"Core"}
		},
		{"id":"librarian-enowork","type":"text","x":3040,"y":940,"width":360,"height":150,"text":"◉ no source work in this admitted selection; the parent retains its authoritative item accounting\n*outcome: reused*","color":"6"},
		{
			"id":"librarian-dcontrols",
			"type":"text",
			"x":1240,
			"y":1340,
			"width":360,
			"height":150,
			"text":"◇ recorded run controls permit processing?",
			"color":"5",
			"librarian":{"actor_lane":"Core"}
		},
		{
			"id":"librarian-validate",
			"type":"text",
			"x":1240,
			"y":1940,
			"width":360,
			"height":150,
			"text":"**3.** validate: checks captured evidence, source identity and duplicate note constraints",
			"librarian":{"actor_lane":"Core"}
		},
		{
			"id":"librarian-stopped",
			"type":"text",
			"x":1240,
			"y":1540,
			"width":360,
			"height":150,
			"text":"persists cancellation, ceiling stop or interruption with completed receipts and pending work for explicit continuation",
			"librarian":{"actor_lane":"Core"}
		},
		{"id":"librarian-eescalated","type":"text","x":3040,"y":1540,"width":360,"height":150,"text":"◉ a run-wide writer, state or authority failure prevents a trustworthy completion handback\n*outcome: escalated*","color":"1"},
		{
			"id":"librarian-dvalidate",
			"type":"text",
			"x":1240,
			"y":2140,
			"width":360,
			"height":150,
			"text":"◇ validation result?",
			"color":"5",
			"librarian":{"actor_lane":"Core"}
		},
		{"id":"librarian-epaused","type":"text","x":3040,"y":1740,"width":360,"height":150,"text":"◉ processing stopped with retained receipts and explicit continuation requirements\n*outcome: paused*","color":"1"},
		{
			"id":"librarian-parse",
			"type":"text",
			"x":1240,
			"y":2340,
			"width":360,
			"height":150,
			"text":"**4.** parse: fetches and extracts text with scripts, maps pages and records extraction quality; dispatches model work only where configured and needed",
			"librarian":{"actor_lane":"Core"}
		},
		{
			"id":"librarian-itemfailed",
			"type":"text",
			"x":1240,
			"y":9140,
			"width":360,
			"height":150,
			"text":"records a failed stage and stops this item's remaining stages; another frozen item's completed work is retained",
			"librarian":{"actor_lane":"Core"}
		},
		{
			"id":"librarian-dparse",
			"type":"text",
			"x":1240,
			"y":2540,
			"width":360,
			"height":150,
			"text":"◇ scripted extraction result and configured conversion request?",
			"color":"5",
			"librarian":{"actor_lane":"Core"}
		},
		{
			"id":"librarian-reduce",
			"type":"text",
			"x":1240,
			"y":9340,
			"width":360,
			"height":150,
			"text":"**13.** reduces declared stage statuses to enriched, partial or failed and persists each item's actual coverage and reasons",
			"librarian":{"actor_lane":"Core"}
		},
		{
			"id":"librarian-dprojection",
			"type":"text",
			"x":1240,
			"y":3540,
			"width":360,
			"height":150,
			"text":"◇ parse continued without an early partial return; PDF or paper projection applicable?",
			"color":"5",
			"librarian":{"actor_lane":"Core"}
		},
		{
			"id":"librarian-convert",
			"type":"text",
			"x":640,
			"y":2740,
			"width":360,
			"height":150,
			"text":"performs configured PDF cleanup or OCR; returns text, page anchors, actual covered pages and explicit task errors",
			"librarian":{"actor_lane":"Model worker (legacy transport)"}
		},
		{
			"id":"librarian-parsegap",
			"type":"text",
			"x":1240,
			"y":4340,
			"width":360,
			"height":150,
			"text":"retains partial/queued conversion or absent readable text and actual OCR gaps; missing material receives no reading credit",
			"librarian":{"actor_lane":"Core"}
		},
		{
			"id":"librarian-dmore",
			"type":"text",
			"x":1240,
			"y":9540,
			"width":360,
			"height":150,
			"text":"◇ more frozen source items?",
			"color":"5",
			"librarian":{"actor_lane":"Core"}
		},
		{
			"id":"librarian-preproject",
			"type":"text",
			"x":1240,
			"y":3740,
			"width":360,
			"height":150,
			"text":"writes a free provisional paper-graph .nodes.json before reading, with text_layer=False; catalogue-only or zero-claim output is possible",
			"librarian":{"actor_lane":"Core"}
		},
		{
			"id":"librarian-parsefinal",
			"type":"text",
			"x":1240,
			"y":4140,
			"width":360,
			"height":150,
			"text":"◇ source units and quality verdict after provisional projection if applicable?",
			"color":"5",
			"librarian":{"actor_lane":"Core"}
		},
		{
			"id":"librarian-conversioncheck",
			"type":"text",
			"x":1240,
			"y":2940,
			"width":360,
			"height":150,
			"text":"checks returned structure and literal page mapping; retains original bytes and unused generated evidence",
			"librarian":{"actor_lane":"Core"}
		},
		{
			"id":"librarian-read",
			"type":"text",
			"x":640,
			"y":4540,
			"width":360,
			"height":150,
			"text":"**5.** read: performs bounded points, limits, terms and grounded lens tasks; source-wide derivations retain their own outcomes",
			"librarian":{"actor_lane":"Model worker (legacy transport)"}
		},
		{
			"id":"librarian-summary",
			"type":"text",
			"x":1240,
			"y":9740,
			"width":360,
			"height":150,
			"text":"**14.** returns per-item stage/coverage/publication receipts and pending Source/lens decisions; reported spend retains unpriced-call limitations",
			"librarian":{"actor_lane":"Core"}
		},
		{
			"id":"librarian-dpreproject",
			"type":"text",
			"x":1240,
			"y":3940,
			"width":360,
			"height":150,
			"text":"◇ provisional projection write result?",
			"color":"5",
			"librarian":{"actor_lane":"Core"}
		},
		{
			"id":"librarian-dconversion",
			"type":"text",
			"x":1240,
			"y":3140,
			"width":360,
			"height":150,
			"text":"◇ conversion result and usable original text?",
			"color":"5",
			"librarian":{"actor_lane":"Core"}
		},
		{
			"id":"librarian-host",
			"type":"text",
			"x":1840,
			"y":4740,
			"width":360,
			"height":150,
			"text":"answers bounded calls through configured legacy routes and their existing task pool; reports transport completion or failure",
			"librarian":{"actor_lane":"Model host"}
		},
		{
			"id":"librarian-dresult",
			"type":"text",
			"x":1240,
			"y":9940,
			"width":360,
			"height":150,
			"text":"◇ source-subset result from recorded statuses?",
			"color":"5",
			"librarian":{"actor_lane":"Core"}
		},
		{
			"id":"librarian-fallback",
			"type":"text",
			"x":1240,
			"y":3340,
			"width":360,
			"height":150,
			"text":"uses original page-mapped text: returned cleanup error retains partial status; unusable generated anchors may still permit complete parse when original text is usable",
			"librarian":{"actor_lane":"Core"}
		},
		{
			"id":"librarian-readcheck",
			"type":"text",
			"x":1240,
			"y":4940,
			"width":360,
			"height":150,
			"text":"checks schemas, literal support, keys and part counters; preserves task/derivation records, although batch read completion currently follows remaining-part counts",
			"librarian":{"actor_lane":"Core"}
		},
		{"id":"librarian-e1","type":"text","x":3040,"y":10340,"width":360,"height":150,"text":"◉ the batch marks source processing enriched from stage statuses; parent acceptance and independent judgment of any derivation gaps remain separate\n*outcome: success*","color":"6"},
		{"id":"librarian-epartial","type":"text","x":3040,"y":10140,"width":360,"height":150,"text":"◉ recorded partial/failed source items remain; other derivation gaps are reported separately and acceptance is not implied\n*outcome: partial*","color":"1"},
		{
			"id":"librarian-dread",
			"type":"text",
			"x":1240,
			"y":5140,
			"width":360,
			"height":150,
			"text":"◇ read stage result?",
			"color":"5",
			"librarian":{"actor_lane":"Core"}
		},
		{
			"id":"librarian-lenses",
			"type":"text",
			"x":1240,
			"y":5340,
			"width":360,
			"height":150,
			"text":"**6.** lenses: records proposals already derived during reading; zero candidates or nothing read can be valid; no lens is accepted here",
			"librarian":{"actor_lane":"Core"}
		},
		{
			"id":"librarian-dlenses",
			"type":"text",
			"x":1240,
			"y":5540,
			"width":360,
			"height":150,
			"text":"◇ lenses stage result?",
			"color":"5",
			"librarian":{"actor_lane":"Core"}
		},
		{
			"id":"librarian-data",
			"type":"text",
			"x":1240,
			"y":5740,
			"width":360,
			"height":150,
			"text":"**7.** Data: assembles kind-specific records from scripted structure and existing current-text readings; preserves partial or inapplicable coverage",
			"librarian":{"actor_lane":"Core"}
		},
		{
			"id":"librarian-ddata",
			"type":"text",
			"x":1240,
			"y":5940,
			"width":360,
			"height":150,
			"text":"◇ Data stage result and document relation applicability?",
			"color":"5",
			"librarian":{"actor_lane":"Core"}
		},
		{
			"id":"librarian-relate",
			"type":"text",
			"x":640,
			"y":6340,
			"width":360,
			"height":150,
			"text":"**8.** relate: proposes relations between eligible fully read document components; zero added relations can be valid",
			"librarian":{"actor_lane":"Model worker (legacy transport)"}
		},
		{
			"id":"librarian-relatestatic",
			"type":"text",
			"x":1240,
			"y":6140,
			"width":360,
			"height":150,
			"text":"retains existing static relations or records relations as not applicable; does not invent a model call",
			"librarian":{"actor_lane":"Core"}
		},
		{
			"id":"librarian-drelate",
			"type":"text",
			"x":1240,
			"y":6540,
			"width":360,
			"height":150,
			"text":"◇ relate stage result?",
			"color":"5",
			"librarian":{"actor_lane":"Core"}
		},
		{
			"id":"librarian-metadata",
			"type":"text",
			"x":1240,
			"y":6740,
			"width":360,
			"height":150,
			"text":"**9.** metadata: copies limited literal Data facts where available and lists required unknown fields; this script is not a general semantic metadata model",
			"librarian":{"actor_lane":"Core"}
		},
		{
			"id":"librarian-dmetadata",
			"type":"text",
			"x":1240,
			"y":6940,
			"width":360,
			"height":150,
			"text":"◇ metadata stage result?",
			"color":"5",
			"librarian":{"actor_lane":"Core"}
		},
		{
			"id":"librarian-review",
			"type":"text",
			"x":640,
			"y":7140,
			"width":360,
			"height":150,
			"text":"**10.** review: drafts the kind-specific Bottom Line and sensitivity findings from source evidence, retaining no answer, refusal and low confidence",
			"librarian":{"actor_lane":"Model worker (legacy transport)"}
		},
		{
			"id":"librarian-reviewcheck",
			"type":"text",
			"x":1240,
			"y":7340,
			"width":360,
			"height":150,
			"text":"checks returned draft structure, literal grounding and reading counters; a usable draft does not override incomplete reading",
			"librarian":{"actor_lane":"Core"}
		},
		{
			"id":"librarian-dreview",
			"type":"text",
			"x":1240,
			"y":7540,
			"width":360,
			"height":150,
			"text":"◇ review stage result?",
			"color":"5",
			"librarian":{"actor_lane":"Core"}
		},
		{
			"id":"librarian-pubcheck",
			"type":"text",
			"x":1240,
			"y":7740,
			"width":360,
			"height":150,
			"text":"**11.** publish: checks PDF applicability, actual full reading, persistent conversion, artifact binding and current trusted accepted folder assignment",
			"librarian":{"actor_lane":"Core"}
		},
		{
			"id":"librarian-dpublication",
			"type":"text",
			"x":1240,
			"y":7940,
			"width":360,
			"height":150,
			"text":"◇ publication admission result?",
			"color":"5",
			"librarian":{"actor_lane":"Core"}
		},
		{
			"id":"librarian-publish",
			"type":"text",
			"x":2440,
			"y":8340,
			"width":360,
			"height":150,
			"text":"**12.** copies the prior paper DB into a new generation, imports the artifact and switches the active catalog pointer through one CLI call",
			"librarian":{"actor_lane":"Geo-Grapher"}
		},
		{
			"id":"librarian-pubna",
			"type":"text",
			"x":1240,
			"y":8140,
			"width":360,
			"height":150,
			"text":"records publish as not applicable for non-PDF or a fully read PDF without a full-conversion artifact; retains limitations",
			"librarian":{"actor_lane":"Core"}
		},
		{
			"id":"librarian-pubgap",
			"type":"text",
			"x":1240,
			"y":8940,
			"width":360,
			"height":150,
			"text":"records incomplete reading, disabled Geo, awaiting accepted folder, FOLDER_STALE or a caught publication refusal/error as partial without erasing reading",
			"librarian":{"actor_lane":"Core"}
		},
		{
			"id":"librarian-publishstorage",
			"type":"text",
			"x":2440,
			"y":8540,
			"width":360,
			"height":150,
			"text":"The call may fail during copy, import or registration. Old and failed-candidate DBs may remain; the candidate is checkpointed and the catalog uses WAL.",
			"librarian":{"actor_lane":"Geo-Grapher"}
		},
		{
			"id":"librarian-dpubresult",
			"type":"text",
			"x":1240,
			"y":8740,
			"width":360,
			"height":150,
			"text":"◇ publication call result?",
			"color":"5",
			"librarian":{"actor_lane":"Core"}
		},
		{"id":"librarian-lane-Tier-0-agent","type":"group","x":20,"y":60,"width":400,"height":10530,"label":"Tier 0 agent"},
		{"id":"librarian-lane-Model-worker-legacy-transport-","type":"group","x":620,"y":60,"width":400,"height":10530,"label":"Model worker (legacy transport)"},
		{"id":"librarian-lane-Core","type":"group","x":1220,"y":60,"width":400,"height":10530,"label":"Core"},
		{"id":"librarian-lane-Model-host","type":"group","x":1820,"y":60,"width":400,"height":10530,"label":"Model host"},
		{"id":"librarian-lane-Geo-Grapher","type":"group","x":2420,"y":60,"width":400,"height":10530,"label":"Geo-Grapher"},
		{"id":"librarian-lane-Outcomes","type":"group","x":3020,"y":60,"width":400,"height":10530,"label":"Outcomes"}
	],
	"edges":[
		{"id":"librarian-e0","fromNode":"librarian-s","toNode":"librarian-boundary","fromSide":"bottom","toSide":"top"},
		{"id":"librarian-e1","fromNode":"librarian-boundary","toNode":"librarian-bind","fromSide":"right","toSide":"left"},
		{"id":"librarian-e2","fromNode":"librarian-bind","toNode":"librarian-dwork","fromSide":"bottom","toSide":"top"},
		{"id":"librarian-e3","fromNode":"librarian-dwork","toNode":"librarian-controls","label":"[nonempty source subset]","fromSide":"bottom","toSide":"top"},
		{"id":"librarian-e4","fromNode":"librarian-dwork","toNode":"librarian-enowork","label":"[empty or already-settled selection] 1a","color":"1","fromSide":"right","toSide":"left"},
		{"id":"librarian-e5","fromNode":"librarian-controls","toNode":"librarian-dcontrols","fromSide":"bottom","toSide":"top"},
		{"id":"librarian-e6","fromNode":"librarian-dcontrols","toNode":"librarian-validate","label":"[active, within the configured ceiling and writer available]","fromSide":"right","toSide":"right"},
		{"id":"librarian-e7","fromNode":"librarian-dcontrols","toNode":"librarian-stopped","label":"[cancelled, interrupted or ceiling reached] 2a","color":"1","fromSide":"bottom","toSide":"top"},
		{"id":"librarian-e8","fromNode":"librarian-dcontrols","toNode":"librarian-eescalated","label":"[run-wide writer, state or authority failure] 2b","color":"1","fromSide":"right","toSide":"left"},
		{"id":"librarian-e9","fromNode":"librarian-validate","toNode":"librarian-dvalidate","fromSide":"bottom","toSide":"top"},
		{"id":"librarian-e10","fromNode":"librarian-dvalidate","toNode":"librarian-parse","label":"[not failed]","fromSide":"bottom","toSide":"top"},
		{"id":"librarian-e11","fromNode":"librarian-dvalidate","toNode":"librarian-itemfailed","label":"[failed] 3a","color":"1","fromSide":"right","toSide":"right"},
		{"id":"librarian-e12","fromNode":"librarian-parse","toNode":"librarian-dparse","fromSide":"bottom","toSide":"top"},
		{"id":"librarian-e13","fromNode":"librarian-dparse","toNode":"librarian-dprojection","label":"[scripted parse continued without requested model assistance]","fromSide":"right","toSide":"right"},
		{"id":"librarian-e14","fromNode":"librarian-dparse","toNode":"librarian-convert","label":"[configured model cleanup or OCR needed] 4a","color":"1","fromSide":"left","toSide":"right"},
		{"id":"librarian-e15","fromNode":"librarian-dparse","toNode":"librarian-parsegap","label":"[fetch or OCR precondition returned partial before provisional projection] 4b","color":"1","fromSide":"right","toSide":"right"},
		{"id":"librarian-e16","fromNode":"librarian-dparse","toNode":"librarian-itemfailed","label":"[uncaught stage failure] 4c","color":"1","fromSide":"right","toSide":"right"},
		{"id":"librarian-e17","fromNode":"librarian-convert","toNode":"librarian-conversioncheck","fromSide":"right","toSide":"left"},
		{"id":"librarian-e18","fromNode":"librarian-conversioncheck","toNode":"librarian-dconversion","fromSide":"bottom","toSide":"top"},
		{"id":"librarian-e19","fromNode":"librarian-dconversion","toNode":"librarian-dprojection","label":"[usable mapped cleanup, or completed OCR without an early partial return]","fromSide":"right","toSide":"right"},
		{"id":"librarian-e20","fromNode":"librarian-dconversion","toNode":"librarian-fallback","label":"[returned cleanup error or unusable generated anchors, with usable original text]","fromSide":"bottom","toSide":"top"},
		{"id":"librarian-e21","fromNode":"librarian-dconversion","toNode":"librarian-dprojection","label":"[returned cleanup error or unusable anchors without usable original text; projection and final chunk check still run]","fromSide":"right","toSide":"right"},
		{"id":"librarian-e22","fromNode":"librarian-dconversion","toNode":"librarian-parsegap","label":"[OCR returned partial before provisional projection]","fromSide":"right","toSide":"right"},
		{"id":"librarian-e23","fromNode":"librarian-dconversion","toNode":"librarian-itemfailed","label":"[uncaught fatal stage failure]","fromSide":"right","toSide":"right"},
		{"id":"librarian-e24","fromNode":"librarian-fallback","toNode":"librarian-dprojection","fromSide":"bottom","toSide":"top"},
		{"id":"librarian-e25","fromNode":"librarian-dprojection","toNode":"librarian-preproject","label":"[PDF or paper; parse did not return early]","fromSide":"bottom","toSide":"top"},
		{"id":"librarian-e26","fromNode":"librarian-dprojection","toNode":"librarian-parsefinal","label":"[other source kind; no paper projection] 4d","color":"1","fromSide":"right","toSide":"right"},
		{"id":"librarian-e27","fromNode":"librarian-preproject","toNode":"librarian-dpreproject","fromSide":"bottom","toSide":"top"},
		{"id":"librarian-e28","fromNode":"librarian-dpreproject","toNode":"librarian-parsefinal","label":"[provisional artifact written; not published]","fromSide":"bottom","toSide":"top"},
		{"id":"librarian-e29","fromNode":"librarian-dpreproject","toNode":"librarian-itemfailed","label":"[uncaught projection write failure] 4e","color":"1","fromSide":"right","toSide":"right"},
		{"id":"librarian-e30","fromNode":"librarian-parsefinal","toNode":"librarian-read","label":"[usable units and no needs_ocr/js_shell verdict; preserve any recorded cleanup-error partial result]","fromSide":"left","toSide":"right"},
		{"id":"librarian-e31","fromNode":"librarian-parsefinal","toNode":"librarian-parsegap","label":"[no readable units, or quality verdict still needs_ocr/js_shell] 4f","color":"1","fromSide":"bottom","toSide":"top"},
		{"id":"librarian-e32","fromNode":"librarian-parsegap","toNode":"librarian-read","fromSide":"left","toSide":"right"},
