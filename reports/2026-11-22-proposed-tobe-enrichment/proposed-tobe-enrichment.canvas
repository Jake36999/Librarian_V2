      }
    },
    {
      "id": "librarian-a16",
      "type": "text",
      "x": 3040,
      "y": 8940,
      "width": 360,
      "height": 150,
      "text": "**16.** review: produces a grounded, kind-specific source draft and Bottom Line with evidence, coverage and explicit unread material",
      "librarian": {
        "actor_lane": "Clerk (tier 2)"
      }
    },
    {
