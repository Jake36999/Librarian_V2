      }
    },
    {
      "id": "librarian-a15",
      "type": "text",
      "x": 3040,
      "y": 8540,
      "width": 360,
      "height": 150,
      "text": "**15.** metadata: proposes content-model field values from the evidence, explains Unknowns and submits the proposal for acceptance",
      "librarian": {
        "actor_lane": "Clerk (tier 2)"
      }
    },
    {
      "id": "librarian-dmetadata",
