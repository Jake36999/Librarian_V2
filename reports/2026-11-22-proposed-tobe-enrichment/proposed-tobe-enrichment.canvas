      "type": "text",
      "x": 4240,
      "y": 9340,
      "width": 360,
      "height": 150,
      "text": "**17.** publish: checks full reading/conversion, artifact binding and projection compatibility; freshly validates enabled, accepted, current, trusted folder assignment",
