      }
    },
    {
      "id": "librarian-a12",
      "type": "text",
      "x": 4240,
      "y": 7340,
      "width": 360,
      "height": 150,
      "text": "**12.** lenses: schema-checks and persists agent-submitted proposals, dispositions, citations and discard reasons; keeps acceptance separate",
      "librarian": {
        "actor_lane": "Core"
      }
    },
    {
      "id": "librarian-partialread",
      "type": "text",
      "x": 4240,
      "y": 6940,
      "width": 360,
      "height": 150,
      "text": "keeps completed part coverage separate from queued derivations and unread parts; later applicable stages use only the evidence actually obtained",
      "librarian": {
        "actor_lane": "Core"
      }
    },
    {
      "id": "librarian-dtidy",
      "type": "text",
      "x": 4240,
      "y": 11540,
      "width": 360,
      "height": 150,
      "text": "◇ within the declared tidy-up and final-pass allowance?",
      "color": "5",
      "librarian": {
        "actor_lane": "Core"
      }
    },
    {
      "id": "librarian-dlenses",
      "type": "text",
      "x": 4240,
      "y": 7540,
      "width": 360,
      "height": 150,
      "text": "◇ lenses stage failed?",
      "color": "5",
      "librarian": {
        "actor_lane": "Core"
      }
    },
    {
      "id": "librarian-a13",
      "type": "text",
      "x": 3040,
      "y": 7740,
      "width": 360,
      "height": 150,
      "text": "**13.** data: proposes the organization of components, chapters and source claims using the readings and script-derived source structure",
      "librarian": {
        "actor_lane": "Clerk (tier 2)"
      }
    },
    {
      "id": "librarian-ddata",
      "type": "text",
      "x": 4240,
      "y": 7940,
      "width": 360,
      "height": 150,
      "text": "◇ Data proposal schema, reference and write status?",
      "color": "5",
      "librarian": {
        "actor_lane": "Core"
      }
    },
    {
      "id": "librarian-a14",
      "type": "text",
      "x": 3040,
      "y": 8140,
      "width": 360,
      "height": 150,
      "text": "**14.** relate: relates fully read components with evidence, preserving inferred document relations and structurally observed repository relations",
      "librarian": {
        "actor_lane": "Clerk (tier 2)"
      }
    },
    {
      "id": "librarian-drelate",
      "type": "text",
      "x": 4240,
