      }
    },
    {
      "id": "librarian-x11",
      "type": "text",
      "x": 1840,
      "y": 17740,
      "width": 360,
      "height": 150,
      "text": "coordinates the approved correction through the assigned agents and accepted Doctor remedies",
      "librarian": {
        "actor_lane": "Lead (tier 1)"
      }
    },
    {
