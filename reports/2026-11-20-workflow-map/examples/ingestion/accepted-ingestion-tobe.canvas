      "type": "text",
      "x": 4240,
      "y": 9740,
      "width": 360,
      "height": 150,
      "text": "records the affirmative authorized ingestion approval; queues work without starting processing",
      "librarian": {
        "actor_lane": "Core"
      }
    },
    {
      "id": "librarian-findcheck",
      "type": "text",
      "x": 4240,
      "y": 14740,
      "width": 360,
      "height": 150,
      "text": "checks required title, Bottom-Line and concept retrieval only for a confirmed committed Source note; records actual searches",
      "librarian": {
        "actor_lane": "Core"
      }
    },
    {
      "id": "librarian-writestate",
      "type": "text",
      "x": 4240,
      "y": 14340,
      "width": 360,
      "height": 150,
      "text": "reconciles the attempt, lease, current note/hash and commit evidence read-only; preserves human edits and records the reserved write checkpoint without assuming a commit",
      "librarian": {
        "actor_lane": "Core"
      }
    },
    {
      "id": "librarian-x12",
      "type": "text",
      "x": 1840,
      "y": 17940,
      "width": 360,
      "height": 150,
      "text": "submits changed artifacts and evidence for independent review; Oracle does not issue worker orders",
      "librarian": {
        "actor_lane": "Lead (tier 1)"
      }
    },
    {
