{
  "nodes": [
    {
      "id": "librarian-title",
      "type": "text",
      "x": 20,
      "y": -200,
      "width": 6380,
      "height": 220,
      "text": "# Proposed ingestion: Owner or tier-0 commissioning, Lead ownership and independent Oracle review\n**Symptom:** Historical ingestion left orchestration and unresolved acceptance handoffs with tier 0.\n**Root cause:** The parent needs accountable role ownership, explicit authority and truthful child outcomes, composed through existing registered processes.\nLanes are actors; red arrows are extensions (numbered); red ends are ways the use case ends without success; orange cards call another use case. Generated from `ingestion-tobe.spec.yaml`."
    },
    {
      "id": "librarian-s",
      "type": "text",
      "x": 40,
      "y": 140,
      "width": 360,
      "height": 70,
      "text": "● start",
      "color": "4",
      "librarian": {
        "actor_lane": "Owner"
      }
    },
    {
      "id": "librarian-a1",
      "type": "text",
      "x": 40,
      "y": 340,
      "width": 360,
      "height": 150,
      "text": "**1.** states the ingestion goal, roots, pre-read exclusions, required outputs, permitted partials and budget; grants only the intended authority",
      "librarian": {
        "actor_lane": "Owner"
      }
    },
    {
      "id": "librarian-dentry",
      "type": "text",
      "x": 4240,
      "y": 540,
      "width": 360,
      "height": 150,
      "text": "◇ commissioning route?",
      "color": "5",
      "librarian": {
        "actor_lane": "Core"
      }
    },
    {
      "id": "librarian-a2",
      "type": "text",
      "x": 640,
      "y": 940,
      "width": 360,
      "height": 150,
      "text": "**2.** commissions the Lead on the Owner's behalf and supplies the agent-authored obligations for independent Oracle review",
      "librarian": {
        "actor_lane": "Tier 0 agent"
      }
    },
    {
      "id": "librarian-directowner",
      "type": "text",
      "x": 40,
      "y": 740,
      "width": 360,
      "height": 150,
      "text": "commissions the Lead directly and supplies or approves the obligations; no tier-0 agent is required",
      "librarian": {
        "actor_lane": "Owner"
      }
    },
    {
      "id": "librarian-a3",
      "type": "text",
      "x": 1840,
      "y": 1140,
      "width": 360,
      "height": 150,
      "text": "**3.** owns execution against the commissioned specification; asks Core to store its version, grants and actual specification owner",
      "librarian": {
        "actor_lane": "Lead (tier 1)"
      }
    },
    {
      "id": "librarian-a4",
      "type": "text",
      "x": 4240,
      "y": 1340,
      "width": 360,
      "height": 150,
      "text": "**4.** inventories roots, fingerprints and literal facts; excludes hidden/scratch content before reading and resolves deepest-root ownership",
      "librarian": {
        "actor_lane": "Core"
      }
    },
    {
      "id": "librarian-d1",
      "type": "text",
      "x": 4240,
      "y": 1540,
      "width": 360,
      "height": 150,
      "text": "◇ reviewed roots current?",
      "color": "5",
      "librarian": {
        "actor_lane": "Core"
      }
    },
    {
