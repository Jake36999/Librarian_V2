      "id": "librarian-capturefault",
      "type": "text",
      "x": 1840,
      "y": 8540,
      "width": 360,
      "height": 150,
      "text": "reports required capture gaps with existing flags; chooses authorized bounded retry or a truthful held/escalated result",
      "librarian": {
        "actor_lane": "Lead (tier 1)"
      }
    },
    {
      "id": "librarian-a16",
      "type": "text",
      "x": 1840,
      "y": 13540,
      "width": 360,
      "height": 150,
      "text": "**19.** makes affirmative Source acceptance decisions only within grant, for full or explicitly permitted partial outputs; no lens is accepted implicitly",
      "librarian": {
        "actor_lane": "Lead (tier 1)"
      }
    },
    {
      "id": "librarian-x6",
      "type": "text",
      "x": 4240,
      "y": 13140,
      "width": 360,
      "height": 150,
      "text": "keeps the Source decision on the named Owner's agenda/context; independently routes required lens accept/reject/defer work",
      "librarian": {
        "actor_lane": "Core"
      }
    },
    {
      "id": "librarian-a20",
      "type": "text",
      "x": 640,
      "y": 17140,
      "width": 360,
      "height": 150,
      "text": "**23.** reviews the Lead's result and independent verdict against the commissioned specification",
      "librarian": {
        "actor_lane": "Tier 0 agent"
      }
    },
    {
      "id": "librarian-ownerreport",
      "type": "text",
      "x": 40,
      "y": 17340,
      "width": 360,
      "height": 150,
      "text": "receives the Lead result and Oracle verdict directly, without an absent tier-0 intermediary",
      "librarian": {
        "actor_lane": "Owner"
      }
    },
    {
      "id": "librarian-capturestore",
      "type": "text",
      "x": 4240,
      "y": 8940,
      "width": 360,
      "height": 150,
      "text": "**13.** stages Source records and records their parent ledger keys; folder metadata retains folder_validate, folder_describe and folder_data with separate review",
      "librarian": {
        "actor_lane": "Core"
      }
    },
    {
      "id": "librarian-acceptrecord",
      "type": "text",
      "x": 4240,
      "y": 13740,
      "width": 360,
      "height": 150,
      "text": "records only affirmative authorized Source decisions with actual actor/reason; separately retains pending, rejected or deferred lens decisions",
      "librarian": {
        "actor_lane": "Core"
      }
    },
    {
      "id": "librarian-x7",
      "type": "text",
      "x": 40,
      "y": 13340,
      "width": 360,
      "height": 150,
      "text": "◇ Owner's Source decision?",
      "color": "5",
      "librarian": {
        "actor_lane": "Owner"
      }
    },
    {
      "id": "librarian-d9",
      "type": "text",
      "x": 640,
      "y": 17340,
      "width": 360,
      "height": 150,
      "text": "◇ ready to return to the Owner?",
      "color": "5",
      "librarian": {
        "actor_lane": "Tier 0 agent"
      }
    },
    {
      "id": "librarian-delivery",
      "type": "text",
      "x": 4240,
      "y": 19140,
      "width": 360,
      "height": 150,
      "text": "records the parent result delivered to its actual specification owner; retains outstanding decisions and limitations",
      "librarian": {
        "actor_lane": "Core"
      }
    },
    {
      "id": "librarian-dapprove",
      "type": "text",
      "x": 4240,
      "y": 9140,
      "width": 360,
      "height": 150,
      "text": "◇ ingestion approval delegated and unreserved?",
      "color": "5",
      "librarian": {
        "actor_lane": "Core"
      }
    },
    {
      "id": "librarian-a17",
      "type": "text",
      "x": 4240,
      "y": 13940,
      "width": 360,
      "height": 150,
      "text": "**20.** applies the guarded Source writer and retains the actual commit/refusal/attempt state; Source acceptance does not accept lenses",
      "librarian": {
        "actor_lane": "Core"
      }
    },
    {
      "id": "librarian-a21",
      "type": "text",
      "x": 1840,
      "y": 17540,
      "width": 360,
      "height": 150,
      "text": "**24.** returns the result to the Owner directly or with the tier-0 reviewed report, retaining all remaining decision owners and limitations",
      "librarian": {
        "actor_lane": "Lead (tier 1)"
      }
    },
    {
      "id": "librarian-x10",
      "type": "text",
      "x": 640,
      "y": 17540,
      "width": 360,
      "height": 150,
      "text": "returns the remaining obligations to the Lead for bounded correction and requests an independent Oracle recheck",
      "librarian": {
        "actor_lane": "Tier 0 agent"
      }
    },
    {
      "id": "librarian-e1",
      "type": "text",
      "x": 6040,
      "y": 19340,
      "width": 360,
      "height": 150,
      "text": "◉ Owner receives the specified result: actual Source acceptance/findability, per-item coverage/publication and independent lens decisions are explicit\n*outcome: success*",
      "color": "6",
      "librarian": {
        "actor_lane": "Outcomes"
      }
    },
    {
      "id": "librarian-a11",
      "type": "text",
      "x": 1840,
      "y": 9540,
      "width": 360,
      "height": 150,
      "text": "**14.** approves the staged selection within the ingestion grant; supplies the actual authority, executor and reason to the approval action",
      "librarian": {
        "actor_lane": "Lead (tier 1)"
      }
    },
    {
      "id": "librarian-approvalowner",
