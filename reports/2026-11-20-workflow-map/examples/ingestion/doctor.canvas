{
	"nodes":[
		{"id":"title","type":"text","x":20,"y":-200,"width":2480,"height":220,"text":"# Diagnose and resolve a failure at a mapped extension point (the doctor)\n**Symptom:** Each failure in the 19-20 November runs was diagnosed and fixed by the tier-0 agent, by hand.\n**Root cause:** The extension points are mapped but not used as an index of remedies.\nLanes are actors; red arrows are extensions (numbered); red ends are ways the use case ends without success; orange cards call another use case. Generated from `doctor.spec.yaml`."},
		{"id":"s","type":"text","x":40,"y":140,"width":360,"height":70,"text":"● start","color":"4"},
		{"id":"a1","type":"text","x":40,"y":340,"width":360,"height":150,"text":"**1.** records the symptom at its extension point: use case, extension, refusal code and evidence"},
		{"id":"a2","type":"text","x":460,"y":540,"width":360,"height":150,"text":"**2.** matches the symptom against the remedy catalogue"},
		{"id":"d1","type":"text","x":460,"y":740,"width":360,"height":150,"text":"◇ a catalogued remedy matches?","color":"5"},
		{"id":"a3","type":"text","x":40,"y":940,"width":360,"height":150,"text":"**3.** computes the remedy's blast radius"},
		{"id":"x1","type":"text","x":460,"y":940,"width":360,"height":150,"text":"drafts a diagnosis from the nearest catalogued cases"},
		{"id":"d2","type":"text","x":880,"y":1140,"width":360,"height":150,"text":"◇ remedy within the doctor's scope?","color":"5"},
		{"id":"x2","type":"text","x":40,"y":1140,"width":360,"height":150,"text":"hands the case and its diagnosis to tier 0"},
		{"id":"a4","type":"text","x":460,"y":1340,"width":360,"height":150,"text":"**4.** runs the remedy's workflow"},
		{"id":"x3","type":"text","x":1300,"y":1340,"width":360,"height":150,"text":"decides the remedy that is outside the doctor's scope"},
		{"id":"r1","type":"text","x":1720,"y":1340,"width":360,"height":150,"text":"⇉ **UC-L**: resolves the case and proposes a new remedy","color":"2"},
		{"id":"a5","type":"text","x":40,"y":1540,"width":360,"height":150,"text":"**5.** re-runs only the checks inside the blast radius"},
		{"id":"d3","type":"text","x":1300,"y":1540,"width":360,"height":150,"text":"◇ Owner approves?","color":"5"},
		{"id":"e2","type":"text","x":2140,"y":1540,"width":360,"height":150,"text":"◉ escalated to tier 0: a failure of the doctor's scope\n*outcome: escalated*","color":"1"},
		{"id":"d4","type":"text","x":40,"y":1740,"width":360,"height":150,"text":"◇ checks pass?","color":"5"},
		{"id":"e3","type":"text","x":2140,"y":1740,"width":360,"height":150,"text":"◉ the Owner declined the remedy; the calling use case pauses\n*outcome: declined*","color":"1"},
		{"id":"a6","type":"text","x":880,"y":1940,"width":360,"height":150,"text":"**6.** validates that the symptom is gone at its extension point"},
		{"id":"x4","type":"text","x":40,"y":1940,"width":360,"height":150,"text":"rolls the remedy back by its compensation step"},
		{"id":"a7","type":"text","x":40,"y":2140,"width":360,"height":150,"text":"**7.** records the case in the catalogue's history: symptom, remedy, result"},
		{"id":"d5","type":"text","x":460,"y":2140,"width":360,"height":150,"text":"◇ another catalogued remedy, within two attempts?","color":"5"},
		{"id":"a8","type":"text","x":460,"y":2340,"width":360,"height":150,"text":"**8.** returns control to the step the extension rejoins"},
		{"id":"e1","type":"text","x":2140,"y":2540,"width":360,"height":150,"text":"◉ resolved; the calling use case rejoins its main flow\n*outcome: resolved*","color":"6"},
		{"id":"lane-Core","type":"group","x":20,"y":60,"width":400,"height":2740,"label":"Core"},
		{"id":"lane-Doctor","type":"group","x":440,"y":60,"width":400,"height":2740,"label":"Doctor"},
		{"id":"lane-Helper-tier-2-","type":"group","x":860,"y":60,"width":400,"height":2740,"label":"Helper (tier 2)"},
		{"id":"lane-Owner","type":"group","x":1280,"y":60,"width":400,"height":2740,"label":"Owner"},
		{"id":"lane-Tier-0-agent","type":"group","x":1700,"y":60,"width":400,"height":2740,"label":"Tier 0 agent"},
		{"id":"lane-Outcomes","type":"group","x":2120,"y":60,"width":400,"height":2740,"label":"Outcomes"}
	],
	"edges":[
