{
  "nodes": [
    {
      "id": "librarian-title",
      "type": "text",
      "x": 20,
      "y": -200,
      "width": 3980,
      "height": 220,
      "text": "# Context 1: User Directs Tier 0 Agent to Operate Librarian (Proposed To-Be Sprint)\n**Symptom:** Tier 0 agents operating Librarian on a user's behalf face MCP curate refusals (process_approved), 150s/600s hidden Chat-tab Ask stalls (F-03), redundant approval prompts, and repeated low-value chunk/gate babysitting.\n**Root cause:** Treat user explicit instruction + scope as the commission (no 2nd approval prompt), have Tier 0 approve Rule-15 manifest envelope on user's behalf, delegate L2/L1 execution to Lead + shared pipeline, enforce concrete Oracle route-collision fallback, and return one receipt.\nLanes are actors; red arrows are extensions (numbered); red ends are ways the use case ends without success; orange cards call another use case. Generated from `librarian-context1-tier0-delegated.spec.yaml`."
    },
    {
      "id": "librarian-s",
      "type": "text",
      "x": 40,
      "y": 140,
      "width": 360,
      "height": 70,
      "text": "● start",
      "color": "4"
    },
    {
      "id": "librarian-request",
      "type": "text",
      "x": 3040,
      "y": 340,
      "width": 360,
      "height": 150,
      "text": "**1.** instructs Tier 0 on Librarian task, scope, exclusions & budget (instruction + scope = commission)"
    },
    {
      "id": "librarian-commission",
      "type": "text",
      "x": 2440,
      "y": 540,
      "width": 360,
      "height": 150,
      "text": "**2.** authors L3 sprint spec (spec_owner=tier0_on_behalf_of_person) & approves Rule-15 envelope with no 2nd prompt"
    },
    {
      "id": "librarian-denv",
      "type": "text",
      "x": 1840,
      "y": 740,
      "width": 360,
      "height": 150,
      "text": "◇ commissioned spec & scope well-formed?",
      "color": "5"
    },
    {
      "id": "librarian-storeenv",
      "type": "text",
      "x": 1840,
      "y": 1540,
      "width": 360,
      "height": 150,
      "text": "**3.** stores spec & mandate_id (commissioned_by=person, decided_by=agent); grants delegated in-scope permissions"
    },
    {
      "id": "librarian-pausecancel",
      "type": "text",
      "x": 1840,
      "y": 940,
      "width": 360,
      "height": 150,
      "text": "logs malformed commission or out-of-scope mismatch without mutating vault; sets resume note"
    },
    {
      "id": "librarian-policy_note",
      "type": "text",
      "x": 1840,
      "y": 1740,
      "width": 360,
      "height": 150,
      "text": "PROPOSED_UNACCEPTED (OD-05): full in-scope Tier-0 delegation; Rule-16 sensitivity/challenged-claim exceptions flagged for Owner review."
    },
    {
      "id": "librarian-t0cancel",
      "type": "text",
      "x": 2440,
      "y": 1140,
      "width": 360,
      "height": 150,
      "text": "reports rejected/malformed commission & clarification needed to user ($0 spent)"
    },
    {
      "id": "librarian-leaddispatch",
      "type": "text",
      "x": 40,
      "y": 1940,
      "width": 360,
      "height": 150,
      "text": "**4.** owns delegated L2 sub-run spec (sub_spec_owner=lead_tier1 <= parent); routes work to Clerk/Scribe"
    },
    {
      "id": "librarian-usercancel",
      "type": "text",
      "x": 3040,
      "y": 1340,
      "width": 360,
      "height": 150,
      "text": "receives rejected/clarification commission notice (vault unchanged)"
    },
    {
      "id": "librarian-callingest",
      "type": "text",
      "x": 1840,
      "y": 2140,
      "width": 360,
      "height": 150,
      "text": "**5.** ⇉ **librarian-ingestion-tobe**: executes shared L2 ingestion -> L2 batch -> L1 source pipeline under commissioned mandate",
      "color": "2"
    },
    {
      "id": "librarian-epaused",
      "type": "text",
      "x": 3640,
      "y": 4940,
      "width": 360,
      "height": 150,
      "text": "◉ paused on boundary/hazard/route-collision Ticket or declined commission; user notified\n*outcome: paused*",
      "color": "1"
    },
    {
      "id": "librarian-oraclesprint",
      "type": "text",
      "x": 1240,
      "y": 3540,
      "width": 360,
      "height": 150,
      "text": "**6.** audits L3 sprint obligations via distinct qualified Oracle route (GLM-5.3 current revisable adapter; isolated context)"
    },
    {
      "id": "librarian-partbranch",
      "type": "text",
      "x": 1840,
      "y": 2540,
      "width": 360,
      "height": 150,
      "text": "evaluates permitted partial coverage & spend vs L3 sprint acceptance criteria"
    },
    {
      "id": "librarian-reusehand",
      "type": "text",
      "x": 1840,
      "y": 2740,
      "width": 360,
      "height": 150,
      "text": "packages reused NAT-13/existing receipts ($0 spend) & unchanged Source list"
    },
    {
      "id": "librarian-t0ticket",
      "type": "text",
      "x": 1840,
      "y": 2940,
      "width": 360,
      "height": 150,
      "text": "records paused Ticket (ext ID, flags, spend, resume target) for out-of-scope, budget, global change, or OD-05 hold"
    },
    {
      "id": "librarian-dcrit",
      "type": "text",
      "x": 1840,
      "y": 2340,
      "width": 360,
      "height": 150,
      "text": "◇ critical security/data-loss/boundary breach vs mapped shortfall?",
      "color": "5"
    },
    {
      "id": "librarian-dverdict",
      "type": "text",
      "x": 1240,
      "y": 3740,
      "width": 360,
      "height": 150,
      "text": "◇ L3 sprint obligations satisfied?",
      "color": "5"
    },
    {
      "id": "librarian-dpperm",
      "type": "text",
      "x": 1840,
      "y": 3140,
      "width": 360,
      "height": 150,
      "text": "◇ partials acceptable for sprint?",
      "color": "5"
    },
    {
      "id": "librarian-t0notifyreuse",
      "type": "text",
      "x": 2440,
      "y": 2940,
      "width": 360,
      "height": 150,
      "text": "notifies human user of reused/unchanged state, evidence hashes & $0 duplicate spend"
    },
    {
      "id": "librarian-t0surface",
      "type": "text",
      "x": 2440,
      "y": 4140,
      "width": 360,
      "height": 150,
      "text": "surfaces single structured boundary, OD-05 policy hold, or collision Ticket + resume target to user"
    },
    {
      "id": "librarian-escrec",
      "type": "text",
      "x": 1840,
      "y": 4540,
      "width": 360,
      "height": 150,
      "text": "routes critical escalated Ticket immediately with flags, evidence hashes & Rule-8 compensation"
    },
    {
      "id": "librarian-doctortriage",
      "type": "text",
      "x": 640,
      "y": 3940,
      "width": 360,
      "height": 150,
      "text": "⇉ **librarian-doctor-tobe**: attempts bounded L3 Ticket recovery via revisable adapter (GLM-5.3 isolated context)",
      "color": "2"
    },
    {
      "id": "librarian-packagereceipt",
      "type": "text",
      "x": 1840,
      "y": 5340,
      "width": 360,
      "height": 150,
      "text": "**7.** commits delivery receipt (promoted IDs, spend, coverage, deferred tabs, Ticket ledger & Agenda)"
    },
    {
      "id": "librarian-partnotify",
      "type": "text",
      "x": 2440,
      "y": 3940,
      "width": 360,
      "height": 150,
      "text": "notifies human user with coverage, spend, not_examined list, deferred tabs & Agenda Tickets"
    },
    {
      "id": "librarian-collisionrec",
      "type": "text",
      "x": 1840,
      "y": 3940,
      "width": 360,
      "height": 150,
      "text": "marks review_status=unverified_route_collision & logs ORACLE_ROUTE_COLLISION Ticket (never claims independent review)"
    },
    {
      "id": "librarian-userreuse",
      "type": "text",
      "x": 3040,
      "y": 3140,
      "width": 360,
      "height": 150,
      "text": "receives confirmation of reused catalogue state (zero duplicate spend)"
    },
    {
      "id": "librarian-userchoice",
      "type": "text",
      "x": 3040,
      "y": 4340,
      "width": 360,
      "height": 150,
      "text": "decides boundary/hazard/route exception cleanly & receives exact Agenda resume path"
    },
    {
      "id": "librarian-failnotify",
      "type": "text",
      "x": 2440,
      "y": 4740,
      "width": 360,
      "height": 150,
      "text": "alerts human user immediately with critical Ticket ID, evidence, spend & failure state"
    },
    {
      "id": "librarian-reentrydoc",
      "type": "text",
      "x": 1840,
      "y": 4140,
      "width": 360,
      "height": 150,
      "text": "verifies bounded L3 repair progress & prepares independent Oracle recheck"
    },
    {
      "id": "librarian-declinerec",
      "type": "text",
      "x": 1840,
      "y": 4340,
      "width": 360,
      "height": 150,
      "text": "persists declined Ticket, attempt history & Rule-8 shown compensation on Agenda"
    },
    {
      "id": "librarian-t0deliver",
      "type": "text",
      "x": 2440,
      "y": 5540,
      "width": 360,
      "height": 150,
      "text": "**8.** synthesizes final handover (evidence, spend, coverage, deferred work, review_status, Tickets)"
    },
    {
      "id": "librarian-userpartial",
      "type": "text",
      "x": 3040,
      "y": 4140,
      "width": 360,
      "height": 150,
      "text": "receives permitted partial coverage report, not_examined list & Agenda Tickets"
    },
    {
      "id": "librarian-ereused",
      "type": "text",
      "x": 3640,
      "y": 3340,
      "width": 360,
      "height": 150,
      "text": "◉ existing catalogue state reused cleanly; user notified with zero duplicate work\n*outcome: reused*",
      "color": "6"
    },
    {
      "id": "librarian-useresc",
      "type": "text",
      "x": 3040,
      "y": 4940,
