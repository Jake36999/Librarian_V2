      "x": 3040,
      "y": 5740,
      "width": 360,
      "height": 150,
      "text": "**9.** receives explicit completion notification in active chat/IDE session + UI Agenda receipt"
    },
    {
      "id": "librarian-epartial",
      "type": "text",
      "x": 3640,
      "y": 4340,
      "width": 360,
      "height": 150,
