{
  "nodes": [
    {
      "id": "librarian-title",
      "type": "text",
      "x": 20,
      "y": -200,
      "width": 3980,
      "height": 220,
      "text": "# Librarian Mixed-Batch Enrichment L2 Pipeline (Proposed To-Be)\n**Symptom:** Batches ran sessionless with before-item-only budget checks, redundant folder drafting, and UC-D recovery without Oracle verification.\n**Root cause:** Record batch activation trigger, reuse NAT-13 folder receipts, enforce MC-10 atomic pre-dispatch reserve, Oracle gate, and single-pass Doctor re-entry.\nLanes are actors; red arrows are extensions (numbered); red ends are ways the use case ends without success; orange cards call another use case. Generated from `librarian-batch-enrichment-tobe.spec.yaml`."
    },
    {
      "id": "librarian-s",
      "type": "text",
      "x": 40,
      "y": 140,
      "width": 360,
      "height": 70,
      "text": "● start",
      "color": "4"
    },
    {
      "id": "librarian-activate",
      "type": "text",
      "x": 3040,
      "y": 340,
      "width": 360,
      "height": 150,
      "text": "**1.** records narrowed L2 batch mandate, parent spec_owner, F-02 checkpoint & commissioned_by / decided_by"
    },
    {
      "id": "librarian-dtrigger",
      "type": "text",
      "x": 3040,
      "y": 540,
      "width": 360,
      "height": 150,
      "text": "◇ batch start authority source?",
      "color": "5"
    },
    {
      "id": "librarian-bind",
      "type": "text",
      "x": 640,
      "y": 1140,
      "width": 360,
      "height": 150,
      "text": "**2.** owns delegated L2 sub-run spec (sub_spec_owner=lead_tier1 <= parent)"
    },
    {
      "id": "librarian-useradmit",
      "type": "text",
      "x": 3040,
      "y": 740,
      "width": 360,
      "height": 150,
      "text": "binds Context 3 direct curate process_approved selection (spec_owner=person)"
    },
    {
      "id": "librarian-t0admit",
      "type": "text",
      "x": 3040,
      "y": 940,
      "width": 360,
      "height": 150,
      "text": "validates Context-1 commissioned mandate_id (or scoped stage_only grant); records decided_by=agent"
    },
    {
      "id": "librarian-admit",
      "type": "text",
      "x": 3040,
      "y": 1340,
      "width": 360,
      "height": 150,
      "text": "**3.** validates session-bound F-02 checkpoint, frozen selection, and role routes"
    },
    {
      "id": "librarian-dadmit",
      "type": "text",
      "x": 3040,
      "y": 1540,
      "width": 360,
      "height": 150,
      "text": "◇ admitted mixed work?",
      "color": "5"
    },
    {
      "id": "librarian-nextitem",
      "type": "text",
      "x": 3040,
      "y": 2140,
      "width": 360,
      "height": 150,
      "text": "**4.** picks next frozen source or folder item; isolates sibling faults"
    },
    {
      "id": "librarian-noworkhandoff",
      "type": "text",
      "x": 640,
      "y": 1740,
      "width": 360,
      "height": 150,
      "text": "returns compatible reuse receipt with pending parent decisions preserved"
    },
    {
      "id": "librarian-pausehandoff",
      "type": "text",
      "x": 640,
      "y": 6340,
      "width": 360,
      "height": 150,
      "text": "returns cancel, MC-10 limit, or ORACLE_ROUTE_COLLISION (unverified) pause Ticket with retained state"
    },
    {
      "id": "librarian-controls",
      "type": "text",
      "x": 3040,
      "y": 2340,
      "width": 360,
      "height": 150,
      "text": "**5.** checks cancel/writer lease and reserves MC-10 budget before item dispatch"
    },
    {
      "id": "librarian-enowork",
      "type": "text",
      "x": 3640,
      "y": 1940,
      "width": 360,
      "height": 150,
      "text": "◉ no fresh batch work; compatible receipts reconciled\n*outcome: reused*",
      "color": "6"
    },
