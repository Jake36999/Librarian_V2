{
  "nodes": [
    {
      "id": "librarian-title",
      "type": "text",
      "x": 20,
      "y": -200,
      "width": 3980,
      "height": 220,
      "text": "# Librarian Process Composition & Mandate Narrowing (Proposed To-Be: L0 Action -> L3 Sprint)\n**Symptom:** Prior model used layer names as swimlanes and omitted per-context spec_owner, Rule-17 Oracle scope judgment, and direct Human user exit handovers.\n**Root cause:** Enforce strict action -> workflow -> pipeline -> sprint composition across true actor lanes, explicit spec_owner attribution, Rule-9/16 narrowing, Rule-17 Oracle scope checks, and user handovers.\nLanes are actors; red arrows are extensions (numbered); red ends are ways the use case ends without success; orange cards call another use case. Generated from `librarian-process-composition-tobe.spec.yaml`."
    },
    {
      "id": "librarian-s",
      "type": "text",
      "x": 40,
      "y": 140,
      "width": 360,
      "height": 70,
      "text": "● start",
      "color": "4"
    },
    {
      "id": "librarian-init",
      "type": "text",
      "x": 40,
      "y": 340,
      "width": 360,
      "height": 150,
      "text": "**1.** initiates work via Context 1 (Tier 0 instruction), Context 2 (Ext project MCP), or Context 3 (Direct UI)"
    },
    {
      "id": "librarian-dspec_owner",
      "type": "text",
      "x": 3040,
      "y": 540,
      "width": 360,
      "height": 150,
      "text": "◇ which actor owns top-level L3 Sprint specification?",
      "color": "5"
    },
    {
      "id": "librarian-t0_spec",
      "type": "text",
      "x": 640,
      "y": 940,
      "width": 360,
      "height": 150,
      "text": "**2.** authors Context-1 L3 spec on user behalf & approves Rule-15 envelope (spec_owner=tier0_on_behalf_of_person)"
    },
    {
      "id": "librarian-c2_spec",
      "type": "text",
      "x": 640,
      "y": 740,
      "width": 360,
      "height": 150,
      "text": "sets Context-2 ext-project MCP spec within bounded read/apply grant (spec_owner=external_project_caller)"
    },
    {
      "id": "librarian-c3_spec",
      "type": "text",
      "x": 40,
      "y": 740,
      "width": 360,
      "height": 150,
      "text": "sets direct UI curate/workflow_grant spec with zero Tier 0 (spec_owner=person)"
    },
    {
      "id": "librarian-compile_manifest",
      "type": "text",
      "x": 3040,
      "y": 1140,
      "width": 360,
      "height": 150,
      "text": "**3.** verifies acyclic action -> workflow -> pipeline -> sprint order; compiles manifest & Rule-15 mandate_id"
    },
    {
      "id": "librarian-lead_subspec",
      "type": "text",
      "x": 2440,
      "y": 1340,
      "width": 360,
      "height": 150,
      "text": "**4.** authors delegated L2/L1 sub-run specs only within parent mandate (sub_spec_owner=lead_tier1 <= parent)"
    },
    {
      "id": "librarian-dnarrow",
      "type": "text",
      "x": 3040,
      "y": 1540,
      "width": 360,
      "height": 150,
      "text": "◇ sub-run manifest fits parent mandate (Rules 9, 10, 16)?",
      "color": "5"
    },
    {
      "id": "librarian-worker_roles",
      "type": "text",
      "x": 1240,
      "y": 2340,
      "width": 360,
      "height": 150,
      "text": "**5.** performs assigned semantic interpretation, review & bounded reading/writing over scripted Core actions"
    },
    {
      "id": "librarian-oracle_scope",
      "type": "text",
      "x": 1840,
      "y": 1740,
      "width": 360,
      "height": 150,
      "text": "judges ungranted call against L3 spec obligations before asking (Rule 17)"
    },
    {
      "id": "librarian-dctx",
      "type": "text",
      "x": 3040,
      "y": 2540,
      "width": 360,
      "height": 150,
      "text": "◇ which L3 activation context executes?",
      "color": "5"
    },
    {
      "id": "librarian-dscope",
      "type": "text",
      "x": 1840,
      "y": 1940,
      "width": 360,
      "height": 150,
      "text": "◇ within spec & parent mandate?",
      "color": "5"
    },
    {
      "id": "librarian-ctx1",
      "type": "text",
      "x": 2440,
      "y": 3140,
      "width": 360,
      "height": 150,
      "text": "**6.** ⇉ **librarian-context1-tier0-delegated**: Context 1 Sprint: Tier 0 commissioned run (Lead sub-run -> ingestion-tobe)",
      "color": "2"
    },
    {
      "id": "librarian-ctx2",
      "type": "text",
      "x": 2440,
      "y": 2740,
      "width": 360,
      "height": 150,
      "text": "⇉ **librarian-context2-external-project-mcp**: Context 2 Sprint: External MCP helpers/apply (optional stage_only ingestion)",
      "color": "2"
    },
    {
      "id": "librarian-ctx3",
      "type": "text",
      "x": 2440,
      "y": 2940,
      "width": 360,
      "height": 150,
      "text": "⇉ **librarian-context3-human-platform-ui**: Context 3 Sprint: Direct UI curation (no Tier 0 -> batch / ingestion-tobe)",
      "color": "2"
    },
    {
      "id": "librarian-log_allowance",
      "type": "text",
      "x": 3040,
      "y": 2140,
      "width": 360,
      "height": 150,
      "text": "records evidence-bearing Rule-17 allowance for end-of-run report"
    },
    {
      "id": "librarian-outpause",
      "type": "text",
      "x": 3040,
      "y": 4540,
      "width": 360,
      "height": 150,
      "text": "persists paused Rule-16/OD-05 gate, MC-10 cap, or ORACLE_ROUTE_COLLISION Ticket with resume target"
    },
    {
      "id": "librarian-outesc",
      "type": "text",
      "x": 3040,
      "y": 4740,
      "width": 360,
      "height": 150,
      "text": "routes critical escalated Ticket immediately with full trace & Rule-8 compensation"
    },
    {
      "id": "librarian-oracle_rollup",
      "type": "text",
      "x": 1840,
      "y": 4140,
      "width": 360,
      "height": 150,
      "text": "**7.** verifies rolled-up L0-L3 obligations & Rule-17 allowances via distinct qualified route (GLM-5.3 current)"
    },
    {
      "id": "librarian-outpartial",
      "type": "text",
      "x": 3040,
      "y": 3340,
      "width": 360,
      "height": 150,
      "text": "persists partial outputs, spend, coverage gaps & open Agenda Tickets"
    },
    {
      "id": "librarian-outreused",
      "type": "text",
      "x": 3040,
      "y": 3540,
      "width": 360,
      "height": 150,
      "text": "persists zero-rework reuse receipt & existing precedent links"
    },
    {
      "id": "librarian-userpaused",
      "type": "text",
      "x": 40,
      "y": 4740,
      "width": 360,
      "height": 150,
      "text": "receives paused Ticket, spend/state to date, & exact Agenda resume path"
    },
    {
      "id": "librarian-useresc",
      "type": "text",
      "x": 40,
      "y": 4940,
      "width": 360,
      "height": 150,
      "text": "receives immediate critical failure alert, Ticket ID & Rule-8 compensation"
    },
    {
      "id": "librarian-dor_comp",
      "type": "text",
      "x": 1840,
      "y": 4340,
      "width": 360,
      "height": 150,
      "text": "◇ composed L3 obligations satisfied cleanly?",
      "color": "5"
    },
    {
      "id": "librarian-userpartial",
      "type": "text",
      "x": 40,
      "y": 3540,
      "width": 360,
      "height": 150,
      "text": "receives permitted partial report, not_examined list, spend & open Tickets"
    },
    {
      "id": "librarian-userreused",
      "type": "text",
      "x": 40,
      "y": 3740,
      "width": 360,
      "height": 150,
      "text": "receives confirmation of reused catalogue state or Applications/ precedent"
    },
    {
      "id": "librarian-epaused",
      "type": "text",
      "x": 3640,
      "y": 4940,
      "width": 360,
      "height": 150,
      "text": "◉ composed run paused cleanly on Rule-16/OD-05, budget, or route-collision Ticket\n*outcome: paused*",
      "color": "1"
    },
    {
      "id": "librarian-eescalated",
      "type": "text",
      "x": 3640,
      "y": 5140,
      "width": 360,
      "height": 150,
      "text": "◉ critical/unresolved Ticket escalated immediately to Human user & spec owner\n*outcome: escalated*",
      "color": "1"
    },
    {
      "id": "librarian-rollreceipt",
      "type": "text",
      "x": 3040,
      "y": 5340,
      "width": 360,
      "height": 150,
      "text": "**8.** persists L0-L3 provenance, spend, coverage, deferrals, Ticket ledger & Agenda receipt (Rule 12)"
    },
    {
      "id": "librarian-epartial",
      "type": "text",
      "x": 3640,
      "y": 3740,
      "width": 360,
      "height": 150,
      "text": "◉ composed run finished with permitted partials & open Tickets notified\n*outcome: partial*",
      "color": "1"
    },
    {
      "id": "librarian-ereused",
      "type": "text",
      "x": 3640,
      "y": 3940,
      "width": 360,
      "height": 150,
      "text": "◉ reused clean across L3-L0 without duplicate spend\n*outcome: reused*",
      "color": "6"
    },
    {
      "id": "librarian-usernotify",
      "type": "text",
      "x": 40,
      "y": 5540,
      "width": 360,
      "height": 150,
      "text": "**9.** receives explicit context handover, result evidence, spend, coverage & deferred work"
    },
    {
      "id": "librarian-e1",
      "type": "text",
      "x": 3640,
      "y": 5740,
      "width": 360,
      "height": 150,
      "text": "◉ L3-L0 composition complete with verified narrowing & user-facing notification\n*outcome: success*",
      "color": "6"
    },
