{
  "nodes": [
    {
      "id": "librarian-title",
      "type": "text",
      "x": 20,
      "y": -200,
      "width": 4580,
      "height": 220,
      "text": "# Context 3: Human Uses Librarian Web UI Directly Without Tier 0 (Proposed To-Be)\n**Symptom:** Staging review suffers status-filter blind spots (accepted/processing hidden), F-09 Bottom-Line form loss on background reload, silent action_done workflow result drops (app.js:8472), and unfindable/queued-Clerk visibility gaps.\n**Root cause:** Model UI initiation (Staging Add source, Chat + Lead, paperclip workflows with zero Tier 0), separate Source/Summary/Folder/Lens/Topic/Search-Index review decisions, Clerk/Lead/Core division, and explicit UI/Agenda notifications.\nLanes are actors; red arrows are extensions (numbered); red ends are ways the use case ends without success; orange cards call another use case. Generated from `librarian-context3-human-platform-ui.spec.yaml`."
    },
    {
      "id": "librarian-s",
      "type": "text",
      "x": 40,
      "y": 140,
      "width": 360,
      "height": 70,
      "text": "● start",
      "color": "4"
    },
    {
      "id": "librarian-ui_entry",
      "type": "text",
      "x": 3640,
      "y": 340,
      "width": 360,
      "height": 150,
      "text": "**1.** initiates in Web UI: Staging -> Add source/Folders, Chat + Attach, or Run a workflow"
    },
    {
      "id": "librarian-dentry",
      "type": "text",
      "x": 3040,
      "y": 540,
      "width": 360,
      "height": 150,
      "text": "◇ which direct UI path selected?",
      "color": "5"
    },
    {
      "id": "librarian-uicapture",
      "type": "text",
      "x": 1840,
      "y": 940,
      "width": 360,
      "height": 150,
      "text": "**2.** records spec_owner=person / curate; captures Bronze evidence & Staging/Folder records"
    },
    {
      "id": "librarian-leaddeleg",
      "type": "text",
      "x": 2440,
      "y": 740,
      "width": 360,
      "height": 150,
      "text": "⇉ **librarian-ingestion-tobe**: delegates multi-root Chat request (sub_spec_owner=lead_tier1 <= person; zero Tier 0)",
      "color": "2"
    },
    {
      "id": "librarian-wgrant",
      "type": "text",
      "x": 1840,
      "y": 740,
      "width": 360,
      "height": 150,
      "text": "binds spec_owner=person workflow_grant + generalized read_access route for paperclip workflow"
    },
    {
      "id": "librarian-leadcoord",
      "type": "text",
      "x": 2440,
      "y": 1140,
      "width": 360,
      "height": 150,
      "text": "**3.** oversees semi-automated UI queue routing (sub_spec_owner=lead_tier1 <= person) & queued Clerk notice"
    },
    {
      "id": "librarian-uinotify",
      "type": "text",
      "x": 3040,
      "y": 5940,
      "width": 360,
      "height": 150,
      "text": "**11.** displays ok/warnings banner, action_done drawer (result, spend, coverage), & Agenda"
    },
    {
      "id": "librarian-uipartial",
      "type": "text",
      "x": 3040,
      "y": 3740,
      "width": 360,
      "height": 150,
      "text": "renders partial coverage banner, spend, unexamined list & remaining Agenda/Staging counts"
    },
    {
      "id": "librarian-uireused",
      "type": "text",
      "x": 3040,
      "y": 2340,
      "width": 360,
      "height": 150,
      "text": "displays no-new-work / reused state & unchanged catalogue links ($0 new spend)"
    },
    {
      "id": "librarian-uiagenda",
      "type": "text",
      "x": 3040,
      "y": 5140,
      "width": 360,
      "height": 150,
      "text": "updates Agenda/Staging status filters & surfaces workflow/Ticket notice & resume path"
    },
    {
      "id": "librarian-uiesc",
      "type": "text",
      "x": 3040,
      "y": 5340,
      "width": 360,
      "height": 150,
      "text": "routes critical error banner, Ticket ID, flags, evidence & Rule-8 compensation immediately"
    },
    {
      "id": "librarian-clerkdraft",
      "type": "text",
      "x": 40,
      "y": 1340,
      "width": 360,
      "height": 150,
      "text": "**4.** proposes W8 title, neutral Bottom Line, What it solves, semantic fields (Unknown if unsupported), topics & sensitivity"
    },
    {
      "id": "librarian-userdone",
      "type": "text",
      "x": 3640,
      "y": 6140,
      "width": 360,
      "height": 150,
      "text": "**12.** receives promoted Source note, spend, Search-Index confirmation & deferred tabs (zero Tier 0)"
    },
    {
      "id": "librarian-userpartial",
      "type": "text",
      "x": 3640,
      "y": 3940,
      "width": 360,
      "height": 150,
      "text": "receives accepted/partial note with coverage caveats, spend & deferred tabs"
    },
    {
      "id": "librarian-userreuse",
      "type": "text",
      "x": 3640,
      "y": 2540,
      "width": 360,
      "height": 150,
      "text": "receives reused catalogue confirmation & unchanged links in UI"
    },
    {
      "id": "librarian-userpaused",
      "type": "text",
      "x": 3640,
      "y": 5340,
      "width": 360,
      "height": 150,
      "text": "receives paused Ticket, ORACLE_ROUTE_COLLISION flag, spend, & Agenda resume path"
    },
    {
      "id": "librarian-useresc",
      "type": "text",
      "x": 3640,
      "y": 5540,
      "width": 360,
      "height": 150,
      "text": "receives urgent UI failure alert with Ticket ID & Rule-8 compensation"
    },
    {
      "id": "librarian-reviewgate1",
      "type": "text",
      "x": 3640,
      "y": 1540,
      "width": 360,
      "height": 150,
      "text": "**5.** retains high-level UI curation: inspects Staging -> Sources (beside/on-demand evidence) & ticks/edits Gate 1 items"
    },
    {
      "id": "librarian-e1",
      "type": "text",
      "x": 4240,
      "y": 6340,
      "width": 360,
      "height": 150,
      "text": "◉ Source findable in Search & Catalogue; user notified in UI (zero Tier 0)\n*outcome: success*",
      "color": "6"
    },
    {
      "id": "librarian-epartial",
      "type": "text",
      "x": 4240,
      "y": 4140,
      "width": 360,
      "height": 150,
      "text": "◉ accepted with explicit partial coverage or pending UI worklists; user notified\n*outcome: partial*",
      "color": "1"
    },
    {
      "id": "librarian-ereused",
      "type": "text",
      "x": 4240,
      "y": 2740,
      "width": 360,
      "height": 150,
      "text": "◉ existing catalogue items confirmed unchanged; UI updated\n*outcome: reused*",
      "color": "6"
    },
    {
      "id": "librarian-epaused",
      "type": "text",
      "x": 4240,
      "y": 5540,
      "width": 360,
      "height": 150,
      "text": "◉ staged/deferred/paused item held visibly on Staging & Agenda; user notified\n*outcome: paused*",
      "color": "1"
    },
    {
      "id": "librarian-eescalated",
      "type": "text",
      "x": 4240,
      "y": 5740,
      "width": 360,
      "height": 150,
      "text": "◉ critical UI/index Ticket surfaced to human user with evidence\n*outcome: escalated*",
      "color": "1"
    },
    {
      "id": "librarian-dgate1choice",
      "type": "text",
      "x": 3640,
      "y": 1740,
      "width": 360,
      "height": 150,
      "text": "◇ Gate 1 Source choice on Staging page?",
      "color": "5"
    },
    {
      "id": "librarian-startbatch",
      "type": "text",
      "x": 1840,
      "y": 1940,
      "width": 360,
      "height": 150,
      "text": "**6.** person clicks Process approved sources (curate process_approved); freezes selected batch"
    },
    {
      "id": "librarian-promoteindex",
      "type": "text",
      "x": 1840,
      "y": 4340,
      "width": 360,
      "height": 150,
      "text": "**9.** runs PromotionGuard CAS (staged_revision check), writes Sources note, IndexGateway FTS & post-write vectors"
    },
    {
      "id": "librarian-uidispose",
      "type": "text",
      "x": 1840,
      "y": 3340,
      "width": 360,
      "height": 150,
      "text": "records status=deferred or quarantines rejected item with reason & retained originals"
    },
    {
      "id": "librarian-batchchild",
      "type": "text",
      "x": 1840,
      "y": 2140,
      "width": 360,
      "height": 150,
      "text": "**7.** ⇉ **librarian-batch-enrichment-tobe**: executes mixed-batch L2 enrichment child under UI curate / workflow_grant",
      "color": "2"
    },
    {
      "id": "librarian-oracleverify",
      "type": "text",
      "x": 1240,
      "y": 4540,
      "width": 360,
      "height": 150,
      "text": "**10.** verifies Staging/Summary integrity & findability via distinct qualified Oracle route (GLM-5.3 current adapter)"
    },
    {
      "id": "librarian-reviewgate2",
      "type": "text",
      "x": 3640,
      "y": 2940,
      "width": 360,
      "height": 150,
      "text": "**8.** retains Gate-2 choices: reviews summary (Bottom Line, Redraft, Unknowns) + Folders/Lenses/Topics/Offerings"
    },
    {
      "id": "librarian-duicrit",
      "type": "text",
      "x": 1840,
      "y": 2340,
      "width": 360,
      "height": 150,
      "text": "◇ critical security/data-loss/boundary breach vs mapped shortfall?",
      "color": "5"
    },
    {
      "id": "librarian-dindex",
      "type": "text",
      "x": 1240,
      "y": 4740,
      "width": 360,
      "height": 150,
      "text": "◇ Source note findable & checks clean?",
      "color": "5"
    },
    {
      "id": "librarian-dgate2choice",
      "type": "text",
      "x": 3640,
      "y": 3140,
      "width": 360,
      "height": 150,
      "text": "◇ Gate 2 Source acceptance choice?",
      "color": "5"
    },
    {
      "id": "librarian-uidoctor",
      "type": "text",
      "x": 640,
      "y": 4940,
      "width": 360,
      "height": 150,
      "text": "⇉ **librarian-doctor-tobe**: attempts bounded YAML Ticket repair (e.g. R5 Rewrite indexes) on UI/batch fault",
      "color": "2"
    },
    {
      "id": "librarian-promotepartial",
      "type": "text",
      "x": 1840,
      "y": 3540,
      "width": 360,
      "height": 150,
      "text": "writes Sources note with coverage=partial & not_examined explicit; updates FTS & vectors"
    },
    {
      "id": "librarian-uireentry",
      "type": "text",
      "x": 1840,
      "y": 5140,
      "width": 360,
      "height": 150,
      "text": "confirms repaired Ticket receipt & refreshes Staging/Search UI state"
    },
