      "text": "◉ critical or unresolved integrity fault escalated\n*outcome: escalated*",
      "color": "1"
    },
    {
      "id": "librarian-parse",
      "type": "text",
      "x": 3040,
      "y": 2540,
      "width": 360,
      "height": 150,
      "text": "**4.** runs scripted fetch, AST/PDF text extract, and page map; saves originals"
    },
    {
      "id": "librarian-quarantine",
      "type": "text",
      "x": 3040,
      "y": 5940,
      "width": 360,
      "height": 150,
      "text": "quarantines poison item to .librarian/quarantine/ and drops provisional cache"
    },
    {
      "id": "librarian-dparse",
      "type": "text",
      "x": 3040,
      "y": 2740,
      "width": 360,
      "height": 150,
      "text": "◇ parse & conversion need?",
      "color": "5"
    },
    {
      "id": "librarian-retpartial_at_c22be28a21",
      "type": "text",
      "x": 640,
      "y": 6140,
      "width": 360,
      "height": 150,
      "text": "returns noncritical partial Source with unmet tasks/quarantine explicit"
    },
    {
      "id": "librarian-dprov",
      "type": "text",
      "x": 3040,
      "y": 4140,
      "width": 360,
      "height": 150,
      "text": "◇ PDF needing provisional cache?",
      "color": "5"
    },
    {
      "id": "librarian-convplan",
      "type": "text",
      "x": 1840,
      "y": 2940,
      "width": 360,
      "height": 150,
      "text": "assigns bounded OCR or cleanup task under qualified role and MC-10 reserve"
    },
    {
      "id": "librarian-parsegap",
      "type": "text",
      "x": 3040,
      "y": 2940,
      "width": 360,
      "height": 150,
      "text": "records unread pages or missing units without granting read credit"
    },
    {
      "id": "librarian-epartial_at_c22be28a21",
      "type": "text",
      "x": 4840,
      "y": 6340,
      "width": 360,
      "height": 150,
      "text": "◉ partial or quarantined Source returned; gap explicit\n*outcome: partial*",
      "color": "1"
    },
    {
      "id": "librarian-preproj",
      "type": "text",
      "x": 3040,
      "y": 4340,
      "width": 360,
      "height": 150,
      "text": "marks provisional .nodes.json (text_layer=False); never counted published"
    },
    {
      "id": "librarian-readplan",
      "type": "text",
      "x": 1840,
      "y": 4540,
      "width": 360,
      "height": 150,
      "text": "**5.** assigns spread chunks, blind lens tasks, and required whole-source passes"
    },
    {
      "id": "librarian-convert",
      "type": "text",
      "x": 2440,
      "y": 3140,
      "width": 360,
      "height": 150,
      "text": "converts pages with [page N] anchors and explicit unread/error markers"
    },
    {
      "id": "librarian-read",
      "type": "text",
      "x": 2440,
      "y": 4740,
      "width": 360,
      "height": 150,
      "text": "**6.** executes bounded chunk and synthesis tasks with MC-10 spend reservation"
    },
    {
      "id": "librarian-convrev",
      "type": "text",
      "x": 1840,
      "y": 3340,
      "width": 360,
      "height": 150,
      "text": "verifies conversion fidelity without attesting unread pages"
    },
    {
      "id": "librarian-host",
      "type": "text",
      "x": 3640,
      "y": 4940,
      "width": 360,
      "height": 150,
      "text": "**7.** answers task requests via qualified route; settles reserved vs actual cost"
    },
    {
      "id": "librarian-convchk",
      "type": "text",
      "x": 3040,
      "y": 3540,
      "width": 360,
      "height": 150,
      "text": "stores conversion with source_authorship metadata and reconciles spend"
    },
    {
      "id": "librarian-readchk",
      "type": "text",
      "x": 3040,
      "y": 5140,
      "width": 360,
      "height": 150,
      "text": "**8.** verifies schemas/quotes (E4/E5) and separates chunk vs _document_pass state"
    },
    {
      "id": "librarian-dconv",
      "type": "text",
      "x": 3040,
      "y": 3740,
      "width": 360,
      "height": 150,
      "text": "◇ conversion usable?",
      "color": "5"
    },
    {
      "id": "librarian-readproof",
      "type": "text",
      "x": 1840,
      "y": 5340,
      "width": 360,
      "height": 150,
      "text": "**9.** reconciles whole-source _document_pass and relate_chapters synthesis (P1-L7)"
    },
    {
      "id": "librarian-fallback",
      "type": "text",
      "x": 3040,
      "y": 3940,
      "width": 360,
      "height": 150,
      "text": "restores original extracted text and keeps conversion gap explicit"
    },
    {
      "id": "librarian-dread",
      "type": "text",
      "x": 3040,
      "y": 5540,
      "width": 360,
      "height": 150,
      "text": "◇ chunk reads + whole derivations complete?",
      "color": "5"
    },
    {
      "id": "librarian-lenses",
      "type": "text",
      "x": 3040,
      "y": 6540,
      "width": 360,
      "height": 150,
      "text": "**10.** stores blind E4/E5 grounded lens candidates (parent acceptance separate)"
    },
    {
      "id": "librarian-dpoison",
      "type": "text",
      "x": 3040,
      "y": 5740,
      "width": 360,
      "height": 150,
      "text": "◇ bounded retries exhausted on poison/ungrounded text?",
      "color": "5"
    },
    {
      "id": "librarian-data",
      "type": "text",
      "x": 3040,
      "y": 6740,
      "width": 360,
      "height": 150,
      "text": "**11.** extracts scripted DIK structural records & static AST code relations ($0; DATA_IS_UNFRAMED)"
    },
    {
      "id": "librarian-partialread",
      "type": "text",
      "x": 3040,
      "y": 6140,
      "width": 360,
      "height": 150,
      "text": "keeps item partial with unread chunks or missing _document_pass explicit"
    },
    {
      "id": "librarian-drelate",
      "type": "text",
      "x": 3040,
      "y": 6940,
      "width": 360,
      "height": 150,
      "text": "◇ multi-chapter document needing semantic relations?",
      "color": "5"
    },
    {
      "id": "librarian-relate",
      "type": "text",
      "x": 1840,
      "y": 7340,
      "width": 360,
      "height": 150,
      "text": "**12.** proposes semantic chapter relations across read chapters (Core persists)"
    },
    {
      "id": "librarian-relateskip",
      "type": "text",
      "x": 3040,
      "y": 7140,
      "width": 360,
      "height": 150,
      "text": "retains Core static AST relations or marks chapter-relate N/A"
    },
    {
      "id": "librarian-metapropose",
      "type": "text",
      "x": 1840,
      "y": 7540,
      "width": 360,
      "height": 150,
      "text": "**13.** proposes semantic content-model metadata fields from evidence; retains Unknown where insufficient"
    },
    {
      "id": "librarian-metadata",
      "type": "text",
      "x": 3040,
      "y": 7740,
      "width": 360,
      "height": 150,
      "text": "**14.** derives deterministic facts/readiness, validates proposed fields against schema, & stores proposals + Unknowns"
    },
    {
      "id": "librarian-review",
      "type": "text",
      "x": 1840,
      "y": 7940,
      "width": 360,
      "height": 150,
      "text": "**15.** drafts neutral Bottom Line & sensitivity check with low_confidence rescue"
    },
    {
      "id": "librarian-reviewchk",
      "type": "text",
      "x": 3040,
      "y": 8140,
      "width": 360,
      "height": 150,
      "text": "**16.** checks Bottom Line schema, literal quote grounding, flags & reading counters (does not override incomplete reading)"
    },
    {
      "id": "librarian-dpub",
      "type": "text",
      "x": 3040,
      "y": 8340,
      "width": 360,
      "height": 150,
      "text": "**17.** ◇ eligible for Geo paper publication?",
      "color": "5"
    },
