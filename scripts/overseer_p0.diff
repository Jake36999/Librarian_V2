+_SECRET_FLAG = re.compile(r"^--?[\w-]*(token|key|secret|password|passwd|auth)[\w-]*$", re.I)
+_SECRET_VALUE = re.compile(r"^(sk-|ghp_|gho_|github_pat_|xox[bp]-|AKIA)[\w-]{8,}")
+
